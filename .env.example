APP_ENV=local
APP_DEBUG=0

# Cookies: usa 1 obligatoriamente cuando el sitio se publique con HTTPS.
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME=28800

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lacaserita_db
DB_USER=root
DB_PASS=

# API RENIEC (apiperu.dev)
RENIEC_PROVEEDOR=apiperu.dev
RENIEC_TOKEN=
RENIEC_URL=https://apiperu.dev/api/dni

# Google OAuth
GOOGLE_CLIENT_ID=

# Mercado Pago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_SANDBOX=true
MP_CURRENCY_ID=PEN
MP_COUNTRY_CODE=PE

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Tienda La Caserita

# Copia local de correos solo para desarrollo. Usa 0 en producción.
MAIL_BACKUP_ENABLED=true
MAIL_BACKUP_DIR=
